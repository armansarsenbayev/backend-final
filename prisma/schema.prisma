generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  HOST
  GUEST
  VENDOR
  COURIER
  ADMIN
}

enum GiftState {
  PENDING
  FUNDED
  PURCHASED
  DELIVERED
  CANCELLED
}

enum ContributionStatus {
  PENDING
  FUNDED
  FAILED
  REFUNDED
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGOUT
  REGISTRY_CREATED
  REGISTRY_UPDATED
  REGISTRY_DELETED
  GIFT_CREATED
  GIFT_UPDATED
  GIFT_DELETED
  GIFT_STATE_CHANGED
  CONTRIBUTION_CREATED
  CONTRIBUTION_FUNDED
  GUEST_CREATED
  GUEST_UPDATED
  GUEST_DELETED
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  username            String    @unique
  passwordHash        String
  role                Role      @default(GUEST)
  isActive            Boolean   @default(true)
  isEmailVerified     Boolean   @default(false)
  emailVerifyToken    String?   @unique
  emailVerifyExpires  DateTime?
  passwordResetToken  String?   @unique
  passwordResetExpires DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  refreshTokens RefreshToken[]
  registries    Registry[]     @relation("HostRegistries")
  auditLogs     AuditLog[]

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Registry {
  id        String   @id @default(uuid()) @db.Uuid
  hostId    String   @db.Uuid
  title     String
  eventDate DateTime
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host   User    @relation("HostRegistries", fields: [hostId], references: [id])
  gifts  Gift[]
  guests Guest[]

  @@index([hostId])
  @@map("registries")
}

model Gift {
  id               String    @id @default(uuid()) @db.Uuid
  registryId       String    @db.Uuid
  title            String
  description      String?
  targetAmountKzt  Decimal   @db.Decimal(12, 2)
  currentAmountKzt Decimal   @default(0) @db.Decimal(12, 2)
  requiredTierRank Int       @default(0)
  isFragile        Boolean   @default(false)
  state            GiftState @default(PENDING)
  vendorId         String?   @db.Uuid
  courierId        String?   @db.Uuid
  version          Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  registry      Registry       @relation(fields: [registryId], references: [id], onDelete: Cascade)
  contributions Contribution[]

  @@index([registryId, state])
  @@index([state])
  @@map("gifts")
}

model Guest {
  id           String   @id @default(uuid()) @db.Uuid
  registryId   String   @db.Uuid
  userId       String?  @db.Uuid
  parentId     String?  @db.Uuid
  displayName  String
  kinshipLabel String
  tierRank     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  registry      Registry       @relation(fields: [registryId], references: [id], onDelete: Cascade)
  parent        Guest?         @relation("GuestHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Guest[]        @relation("GuestHierarchy")
  contributions Contribution[]

  @@index([registryId])
  @@index([parentId])
  @@index([registryId, tierRank])
  @@map("guests")
}

model Contribution {
  id               String             @id @default(uuid()) @db.Uuid
  giftId           String             @db.Uuid
  guestId          String             @db.Uuid
  amountKzt        Decimal            @db.Decimal(12, 2)
  amountOriginal   Decimal            @db.Decimal(12, 2)
  currencyOriginal String             @db.Char(3)
  exchangeRate     Decimal            @db.Decimal(14, 6)
  rateLockedAt     DateTime
  status           ContributionStatus @default(PENDING)
  createdAt        DateTime           @default(now())

  gift  Gift  @relation(fields: [giftId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([giftId, status])
  @@index([giftId, createdAt])
  @@index([rateLockedAt])
  @@map("contributions")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @db.Uuid
  action     AuditAction
  entityType String
  entityId   String      @db.Uuid
  metadata   Json?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
