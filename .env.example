# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saukele_dev?schema=public

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-random-64-char-string-for-access-tokens-here
JWT_REFRESH_SECRET=replace-with-different-random-64-char-string-for-refresh-here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5

# ── Exchange rates ────────────────────────────────────────────────────────────
EXCHANGE_PROVIDER=mock

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get your API key at: https://resend.com → Dashboard → API Keys
RESEND_API_KEY=re_fGvrdcpC_AtccG8KS6GqyV2vdMqWUpCdo
EMAIL_FROM=Saukele <onboarding@resend.dev>
APP_URL=http://localhost:3000

