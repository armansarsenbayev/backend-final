# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/saukele

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-64-random-chars
JWT_REFRESH_SECRET=change-me-another-64-random-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000

# ── Exchange rates ────────────────────────────────────────────────────────────
EXCHANGE_PROVIDER=mock

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Saukele <onboarding@resend.dev>
APP_URL=http://localhost:3000

# ── Redis / Upstash ───────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
REDIS_URL=redis://localhost:6379

# ── Admin registration ────────────────────────────────────────────────────────
# Secret key required in X-Admin-Key header to create ADMIN users
ADMIN_REGISTRATION_KEY=your-admin-registration-key-min-16-chars

# ── Development email override ────────────────────────────────────────────────
# Resend free plan: all emails go to this address regardless of recipient
# Remove or leave empty in production
DEV_EMAIL_OVERRIDE=your-real-email@gmail.com